#version 460
#extension GL_EXT_ray_tracing : require

layout(set = 0, binding = 0) uniform accelerationStructureEXT scene;
layout(set = 0, binding = 1, rgba8) uniform image2D carrier;
layout(set = 0, binding = 2) uniform sampler2D source;
layout(set = 0, binding = 3, std430) readonly buffer Requests { vec2 uv[]; } requests;
layout(location = 0) rayPayloadEXT uint completion;

// The current compiler drops external buffer store_deref. Use its existing
// RGB image store as a lossless transport for all 32 bits, including alpha's
// float bits. Alpha of the carrier is intentionally unused. The quarter-byte
// offset avoids the driver's truncation boundary; host verifies all 256 bytes.
vec3 encode(uvec3 bytes) { return (vec3(bytes) + vec3(0.25)) / 255.0; }
void store_word(uint slot, uint bits) {
    int x = int(256 + 2 * slot);
    uvec3 low = uvec3(bits, bits >> 8, bits >> 16) & uvec3(255);
    uvec3 high = uvec3(bits >> 24, (bits & 255) ^ 255, ((bits >> 24) & 255) ^ 255);
    imageStore(carrier, ivec2(x, 0), vec4(encode(low), 1));
    imageStore(carrier, ivec2(x + 1, 0), vec4(encode(high), 1));
}

void main() {
    uint i = gl_LaunchIDEXT.x;
    imageStore(carrier, ivec2(i, 0), vec4(encode(uvec3(i)), 1));
    imageStore(carrier, ivec2(i + 64, 0), vec4(encode(uvec3(i + 64)), 1));
    imageStore(carrier, ivec2(i + 128, 0), vec4(encode(uvec3(i + 128)), 1));
    imageStore(carrier, ivec2(i + 192, 0), vec4(encode(uvec3(i + 192)), 1));
    // Keep the default V5 traversal/frontier gate; empty TLAS guarantees miss.
    completion = 0;
    traceRayEXT(scene, gl_RayFlagsOpaqueEXT, 255, 0, 0, 0,
                vec3(0), 0.001, vec3(0, 0, 1), 1.0, 0);
    vec4 color = textureLod(source, requests.uv[i], 0.0);
    store_word(8 * i, floatBitsToUint(color.r));
    store_word(8 * i + 1, floatBitsToUint(color.g));
    store_word(8 * i + 2, floatBitsToUint(color.b));
    store_word(8 * i + 3, floatBitsToUint(color.a));
    store_word(8 * i + 4, floatBitsToUint(float(completion)));
    store_word(8 * i + 5, floatBitsToUint(123.0));
    store_word(8 * i + 6, floatBitsToUint(456.0));
    store_word(8 * i + 7, floatBitsToUint(789.0));
}
