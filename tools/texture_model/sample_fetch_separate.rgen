#version 460
#extension GL_EXT_samplerless_texture_functions : require
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
layout(set = 0, binding = 0) uniform accelerationStructureEXT scene;
layout(set = 0, binding = 1, rgba8) uniform image2D carrier;
layout(set = 0, binding = 2) uniform texture2D source;
layout(set = 0, binding = 3, std430) readonly buffer Requests { vec4 uv[]; } requests;
layout(set = 0, binding = 4, std430) buffer Results { vec4 values[]; } direct;
layout(set = 0, binding = 5, std430) readonly buffer Address { uint64_t address; } output_address;
layout(buffer_reference, std430, buffer_reference_align = 16) buffer ReferenceResults { vec4 values[]; };
layout(location = 0) rayPayloadEXT uint completion;
void main() {
    uint i = gl_LaunchIDEXT.x;
    completion = 0;
    traceRayEXT(scene, gl_RayFlagsOpaqueEXT, 255, 0, 0, 0,
                vec3(0), 0.001, vec3(0, 0, 1), 1.0, 0);
    int lod = int(requests.uv[i].z);
    vec4 color = texelFetch(source, ivec2(requests.uv[i].xy), lod);
    ivec2 size = textureSize(source, lod);
    int levels = textureQueryLevels(source);
    vec4 marker = vec4(float(completion), vec2(size), float(levels));
    direct.values[2 * i] = color;
    direct.values[2 * i + 1] = marker;
    ReferenceResults indirect = ReferenceResults(output_address.address);
    indirect.values[2 * i] = color;
    indirect.values[2 * i + 1] = marker;
    imageStore(carrier, ivec2(i, 0), color);
}
