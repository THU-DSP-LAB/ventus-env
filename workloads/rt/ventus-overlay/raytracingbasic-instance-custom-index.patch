diff --git a/shaders/glsl/raytracingbasic/closesthit.rchit b/shaders/glsl/raytracingbasic/closesthit.rchit
--- a/shaders/glsl/raytracingbasic/closesthit.rchit
+++ b/shaders/glsl/raytracingbasic/closesthit.rchit
@@ -11 +11,33 @@ void main()
-  hitValue = barycentricCoords;
+  const uint instanceCustomIndex = gl_InstanceCustomIndexEXT;
+  if (instanceCustomIndex == 0u)
+    hitValue = barycentricCoords;
+  else if (instanceCustomIndex == 0x5au)
+    hitValue = vec3(1.0f, 0.0f, 1.0f);
+  else if (instanceCustomIndex == 0x5bu) {
+    const float matrixError =
+      length(gl_ObjectToWorldEXT[0] - vec3(0.5f, 0.0f, 0.0f)) +
+      length(gl_ObjectToWorldEXT[1] - vec3(0.0f, 0.75f, 0.0f)) +
+      length(gl_ObjectToWorldEXT[2] - vec3(0.0f, 0.0f, 1.25f)) +
+      length(gl_ObjectToWorldEXT[3] - vec3(0.0f, 0.0f, 0.2f)) +
+      length(gl_WorldToObjectEXT[0] - vec3(2.0f, 0.0f, 0.0f)) +
+      length(gl_WorldToObjectEXT[1] - vec3(0.0f, 1.333333333f, 0.0f)) +
+      length(gl_WorldToObjectEXT[2] - vec3(0.0f, 0.0f, 0.8f)) +
+      length(gl_WorldToObjectEXT[3] - vec3(0.0f, 0.0f, -0.16f));
+    const vec3 expectedObjectOrigin =
+      gl_WorldToObjectEXT * vec4(gl_WorldRayOriginEXT, 1.0f);
+    const vec3 expectedObjectDirection =
+      gl_WorldToObjectEXT * vec4(gl_WorldRayDirectionEXT, 0.0f);
+    const vec3 reconstructedWorldOrigin =
+      gl_ObjectToWorldEXT * vec4(gl_ObjectRayOriginEXT, 1.0f);
+    const vec3 reconstructedWorldDirection =
+      gl_ObjectToWorldEXT * vec4(gl_ObjectRayDirectionEXT, 0.0f);
+    const float rayError =
+      length(gl_ObjectRayOriginEXT - expectedObjectOrigin) +
+      length(gl_ObjectRayDirectionEXT - expectedObjectDirection) +
+      length(reconstructedWorldOrigin - gl_WorldRayOriginEXT) +
+      length(reconstructedWorldDirection - gl_WorldRayDirectionEXT);
+    hitValue = matrixError < 0.0001f && rayError < 0.0001f
+      ? vec3(0.0f, 1.0f, 0.0f)
+      : vec3(1.0f, 0.0f, 0.0f);
+  } else
+    hitValue = vec3(0.0f, 1.0f, 1.0f);
