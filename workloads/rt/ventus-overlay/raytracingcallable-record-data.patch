diff --git a/examples/raytracingcallable/raytracingcallable.cpp b/examples/raytracingcallable/raytracingcallable.cpp
--- a/examples/raytracingcallable/raytracingcallable.cpp
+++ b/examples/raytracingcallable/raytracingcallable.cpp
@@ -13,0 +14 @@
+#include <cstdlib>
@@ -44,0 +46,2 @@
+	bool useCallableRecordData = false;
+	std::string callableShaderOverride{};
@@ -48,0 +52,7 @@
+		const char* recordDataEnv = std::getenv("VENTUS_CALLABLE_RECORD_DATA_ALT");
+		useCallableRecordData =
+			recordDataEnv && std::strtoul(recordDataEnv, nullptr, 0) != 0;
+		const std::string negativeCallableMode =
+			std::getenv("VENTUS_CALLABLE_NEGATIVE") ? std::getenv("VENTUS_CALLABLE_NEGATIVE") : "";
+		if (negativeCallableMode == "nested")
