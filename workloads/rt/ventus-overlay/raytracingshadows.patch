diff --git a/shaders/glsl/raytracingshadows/miss_secondary.rmiss b/shaders/glsl/raytracingshadows/miss_secondary.rmiss
new file mode 100644
--- /dev/null
+++ b/shaders/glsl/raytracingshadows/miss_secondary.rmiss
@@ -0,0 +1,30 @@
+#version 460
+#extension GL_EXT_ray_tracing : require
+
+layout(binding = 0, set = 0) uniform accelerationStructureEXT topLevelAS;
+layout(binding = 2, set = 0) uniform CameraProperties
+{
+    mat4 viewInverse;
+    mat4 projInverse;
+    vec4 lightPos;
+} cam;
+
+layout(location = 0) rayPayloadInEXT vec3 hitValue;
+layout(location = 2) rayPayloadEXT bool secondaryHit;
+
+void main()
+{
+    vec4 target = cam.projInverse * vec4(0.0, 0.0, 1.0, 1.0);
+    vec3 direction =
+        (cam.viewInverse * vec4(normalize(target.xyz / target.w), 0.0)).xyz;
+
+    secondaryHit = true;
+    traceRayEXT(topLevelAS,
+        gl_RayFlagsTerminateOnFirstHitEXT |
+        gl_RayFlagsOpaqueEXT |
+        gl_RayFlagsSkipClosestHitShaderEXT,
+        0xff, 0, 0, 1,
+        gl_WorldRayOriginEXT, 0.001, direction, 10000.0, 2);
+
+    hitValue = secondaryHit ? vec3(0.4, 0.0, 0.4) : vec3(0.0, 0.0, 0.2);
+}
